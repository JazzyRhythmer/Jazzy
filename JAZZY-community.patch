+.maker-note {
+  display: flex;
+  justify-content: space-between;
+  align-items: baseline;
+  flex-wrap: wrap;
+  gap: 8px 24px;
+  border-bottom: 1px solid var(--line);
+  padding-bottom: 21px;
+}
+.maker-note p {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 4px 14px;
+  margin: 0;
+  font-size: 11px;
+}
+.maker-note p a { color: var(--ink); }
+.community-links {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px 18px;
+  font: 11px/1.7 var(--mono);
+}
+.community-links a, .studio-notes-fine a, .studio-notes-fallback {
+  color: var(--muted);
+  text-decoration: underline;
+  text-underline-offset: 5px;
+}
+.community-links a:hover, .maker-note p a:hover,
+.studio-notes-fine a:hover, .studio-notes-fallback:hover { color: var(--accent); }
+.community-panel {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: clamp(24px, 5vw, 70px);
+  align-items: center;
+}
+.community-panel h2 { margin: 12px 0; }
+.community-panel h3 { margin: 0; font-size: 19px; font-weight: 500; }
+.community-panel p { max-width: 34em; }
+.community-panel .label { color: var(--accent); }
+.community-panel .button { margin-top: 6px; }
+.community-panel .community-links { margin-top: 16px; }
+.studio-signup {
+  min-width: 0;
+  padding: clamp(18px, 3vw, 30px);
+  border: 1px solid var(--line);
+  background: var(--plate);
+}
+.studio-signup > p:first-child { margin: 0 0 16px; }
+.studio-signup .formkit-form[data-uid="6dd4006c7c"] {
+  width: 100% !important;
+  max-width: none !important;
+  background: transparent !important;
+  border: 0 !important;
+  padding: 0 !important;
+}
+.studio-signup [data-style="clean"] { padding: 0 !important; }
+.studio-signup .formkit-form .formkit-fields {
+  display: grid !important;
+  grid-template-columns: minmax(0, 1fr) auto;
+  gap: 10px;
+  margin: 0 !important;
+}
+.studio-signup .formkit-form .formkit-field,
+.studio-signup .formkit-form .formkit-submit {
+  min-width: 0;
+  margin: 0 !important;
+}
+.studio-signup .formkit-form .formkit-input,
+.studio-signup .formkit-form .formkit-submit {
+  min-height: 48px;
+  border-radius: 0 !important;
+}
+.studio-signup #studio-notes-form .formkit-input {
+  background: var(--ink) !important;
+  color: var(--bg) !important;
+  font-size: 16px !important;
+}
+.studio-signup #studio-notes-form .formkit-submit {
+  background: var(--accent) !important;
+  color: var(--bg) !important;
+  font: 12px var(--mono) !important;
+  font-weight: bold !important;
+}
+.studio-signup .formkit-form .formkit-submit span { padding-inline: 15px !important; }
+.studio-signup #studio-notes-form .formkit-submit:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 4px;
+}
+.studio-signup .formkit-powered-by-convertkit[data-variant="dark"] { filter: invert(1); }
+.studio-signup .formkit-powered-by-convertkit-container { margin-top: 12px !important; }
+.studio-notes-fine, .studio-notes-fallback { font: 11px/1.7 var(--mono); }
